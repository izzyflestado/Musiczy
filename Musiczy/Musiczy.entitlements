<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app send Apple events to Spotify / Music (needed if Hardened Runtime is on).
	     The App Sandbox must stay OFF: the app runs mdfind and reads files next to your songs. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
